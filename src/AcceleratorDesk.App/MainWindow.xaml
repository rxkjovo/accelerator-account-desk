<Window x:Class="AcceleratorDesk.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="加速账户助手" Width="1320" Height="820" MinWidth="1100" MinHeight="680">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <Border Background="#10171E" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
      <Grid Margin="16,26,16,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel>
          <Border Width="40" Height="40" Background="{StaticResource Accent}" CornerRadius="11" HorizontalAlignment="Left">
            <TextBlock Text="A" FontSize="24" FontWeight="Bold" Foreground="#18210F" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="加速账户助手" FontSize="17" FontWeight="SemiBold" Margin="0,16,0,5" />
          <TextBlock Text="ACCOUNT DESK" FontSize="10" Foreground="{StaticResource Muted}" />
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,40,0,0">
          <TextBlock Text="工作台" Style="{StaticResource FieldLabel}" Margin="10,0,0,12" />
          <Button x:Name="AccountsNav" Content="◈    账号总览" Style="{StaticResource NavButton}" Click="AccountsNav_Click" />
          <Button x:Name="PhonesNav" Content="▤    手机号" Style="{StaticResource NavButton}" Click="PhonesNav_Click" />
          <Button x:Name="RedemptionsNav" Content="◷    兑换记录" Style="{StaticResource NavButton}" Click="RedemptionsNav_Click" />
          <Button x:Name="SettingsNav" Content="⚙    设置与说明" Style="{StaticResource NavButton}" Click="SettingsNav_Click" />
        </StackPanel>
        <Border Grid.Row="3" Background="#18232C" CornerRadius="8" Padding="12">
          <StackPanel><TextBlock Text="●  本地记录" Foreground="{StaticResource Cyan}" FontSize="12" />
            <TextBlock Text="账号资料保存在这台电脑" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,7,0,0" TextWrapping="Wrap" />
            <TextBlock Text="v0.1.0" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,9,0,0" /></StackPanel>
        </Border>
      </Grid>
    </Border>
    <Grid Grid.Column="1" Margin="26,24,26,14">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Grid Margin="0,0,0,22">
        <StackPanel><TextBlock x:Name="PageTitle" Text="账号总览" FontSize="26" FontWeight="SemiBold" />
          <TextBlock x:Name="PageSubtitle" Text="账号、时长与到期进度，一处查看。" Foreground="{StaticResource Muted}" Margin="0,7,0,0" /></StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button Content="刷新" Click="Refresh_Click" Margin="0,0,10,0" />
          <Button x:Name="NewAccountButton" Content="＋  新增账号" Style="{StaticResource PrimaryButton}" Click="NewAccount_Click" />
        </StackPanel>
      </Grid>
      <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,-12,22">
        <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="17,14">
          <StackPanel><TextBlock Text="账号总数" Foreground="{StaticResource Muted}" FontSize="12" /><TextBlock x:Name="TotalCount" Text="0" FontSize="29" FontWeight="SemiBold" Margin="0,7,0,2" /><TextBlock Text="包含历史账号" FontSize="10" Foreground="{StaticResource Muted}" /></StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="17,14">
          <StackPanel><TextBlock Text="时长有效" Foreground="{StaticResource Muted}" FontSize="12" /><TextBlock x:Name="ActiveCount" Text="0" Foreground="{StaticResource Accent}" FontSize="29" FontWeight="SemiBold" Margin="0,7,0,2" /><TextBlock Text="按已记录的实际到期时间" FontSize="10" Foreground="{StaticResource Muted}" /></StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="17,14">
          <StackPanel><TextBlock Text="三天内到期" Foreground="{StaticResource Muted}" FontSize="12" /><TextBlock x:Name="SoonCount" Text="0" Foreground="#F5CC7A" FontSize="29" FontWeight="SemiBold" Margin="0,7,0,2" /><TextBlock x:Name="ExpiredSummary" Text="已到期 0 个" FontSize="10" Foreground="{StaticResource Muted}" /></StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="17,14">
          <StackPanel><TextBlock Text="注销待跟进" Foreground="{StaticResource Muted}" FontSize="12" /><TextBlock x:Name="PendingCount" Text="0" Foreground="{StaticResource Cyan}" FontSize="29" FontWeight="SemiBold" Margin="0,7,0,2" /><TextBlock Text="已申请、等待中或待核实" FontSize="10" Foreground="{StaticResource Muted}" /></StackPanel>
        </Border>
      </UniformGrid>
      <Grid Grid.Row="2">
        <Grid x:Name="AccountsPage">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="272" /></Grid.ColumnDefinitions>
          <Border Style="{StaticResource Card}">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <Grid Margin="14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="100" /><ColumnDefinition Width="128" /></Grid.ColumnDefinitions>
                <TextBox x:Name="AccountSearch" AutomationProperties.Name="搜索账号" ToolTip="搜索账号、备注或关联手机号" TextChanged="AccountFilters_Changed" />
                <TextBlock Text="搜索账号 / 备注 / 手机号" IsHitTestVisible="False" Foreground="#71818F" Margin="12,0,0,0" VerticalAlignment="Center">
                  <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=AccountSearch}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
                <ComboBox x:Name="ProviderFilter" Grid.Column="1" Margin="8,0,0,0" AutomationProperties.Name="筛选登录渠道" SelectionChanged="AccountFilters_Changed" />
                <ComboBox x:Name="MembershipFilter" Grid.Column="2" Margin="8,0,0,0" AutomationProperties.Name="筛选时长状态" SelectionChanged="AccountFilters_Changed" />
              </Grid>
              <Grid Grid.Row="1">
                <DataGrid x:Name="AccountsGrid" AutomationProperties.Name="账号列表" SelectionChanged="AccountsGrid_SelectionChanged" MouseDoubleClick="AccountsGrid_DoubleClick">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="渠道" Binding="{Binding Provider}" Width="62" />
                    <DataGridTextColumn Header="账号" Binding="{Binding Identifier}" Width="125" />
                    <DataGridTextColumn Header="备注" Binding="{Binding Nickname}" Width="100" />
                    <DataGridTextColumn Header="时长状态" Binding="{Binding Membership}" Width="100" />
                    <DataGridTextColumn Header="到期时间" Binding="{Binding Expiry}" Width="148" />
                    <DataGridTextColumn Header="手机号" Binding="{Binding Phone}" Width="120" />
                    <DataGridTextColumn Header="注销状态" Binding="{Binding Cancellation}" Width="95" />
                  </DataGrid.Columns>
                </DataGrid>
                <Border x:Name="AccountEmpty" Background="#141C25" Margin="0,39,0,0">
                  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="350" Margin="25">
                    <TextBlock Text="＋" FontSize="35" Foreground="{StaticResource Cyan}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="EmptyTitle" Text="从第一个账号开始" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,9" />
                    <TextBlock x:Name="EmptyDescription" Text="添加已有 QQ 或微博账号，记录实际到账时长和到期日期。" Style="{StaticResource MutedText}" TextAlignment="Center" />
                    <Button x:Name="EmptyAddButton" Content="添加账号" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Margin="0,20,0,0" Click="NewAccount_Click" />
                  </StackPanel>
                </Border>
              </Grid>
              <Grid Grid.Row="2" Margin="14,10">
                <TextBlock x:Name="AccountListSummary" Text="共 0 个账号" Foreground="{StaticResource Muted}" VerticalAlignment="Center" FontSize="11" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="CopyAccountButton" Content="复制账号" Click="CopyAccount_Click" MinHeight="30" Padding="10,5" Margin="0,0,8,0" IsEnabled="False" /><Button x:Name="EditAccountButton" Content="编辑" Click="EditAccount_Click" MinHeight="30" Padding="13,5" IsEnabled="False" /></StackPanel>
              </Grid>
            </Grid>
          </Border>
          <Border Grid.Column="2" Style="{StaticResource Card}" Padding="17">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <TextBlock Text="当前账号" FontSize="11" Foreground="{StaticResource Muted}" />
                <TextBlock x:Name="DetailIdentifier" Text="选择一个账号" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,10,0,4" />
                <TextBlock x:Name="DetailSubtitle" Text="在左侧查看和选择账号" Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="11" />
                <Border Background="#1E3027" CornerRadius="5" Padding="9,6" Margin="0,16,0,0"><TextBlock x:Name="DetailMembership" Text="未记录到期" Foreground="{StaticResource Accent}" FontSize="11" /></Border>
                <TextBlock x:Name="DetailExpiry" Text="到期时间：未记录" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,10,0,0" TextWrapping="Wrap" />
                <TextBlock x:Name="DetailCancellation" Text="注销状态：未记录" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap" />
                <TextBlock x:Name="DetailWait" Text="官方等待期限：未知" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap" />
                <Border Height="1" Background="{StaticResource Line}" Margin="0,20" />
                <TextBlock Text="操作流程" FontWeight="SemiBold" Margin="0,0,0,14" />
                <TextBlock Text="01   注册 / 登录平台账号" FontSize="12" />
                <TextBlock Text="在官方入口完成注册与验证" FontSize="10" Foreground="{StaticResource Muted}" Margin="23,5,0,10" />
                <Button x:Name="ProviderEntryButton" Content="打开 QQ 注册" Click="ProviderEntry_Click" HorizontalContentAlignment="Center" />
                <TextBlock Text="02   登录迅雷游戏加速器" FontSize="12" Margin="0,20,0,0" />
                <TextBlock Text="在客户端完成 QQ / 微博授权" FontSize="10" Foreground="{StaticResource Muted}" Margin="23,5,0,10" />
                <Button Content="打开迅雷客户端" Click="OpenClient_Click" />
                <TextBlock Text="03   兑换并记录时长" FontSize="12" Margin="0,20,0,0" />
                <TextBlock Text="使用官方兑换入口，保存实际结果" FontSize="10" Foreground="{StaticResource Muted}" Margin="23,5,0,10" />
                <Button x:Name="NewRedemptionButton" Content="记录兑换结果" Click="NewRedemption_Click" IsEnabled="False" />
                <TextBlock Text="验证码、授权和注销确认由你在官方界面完成。" Style="{StaticResource MutedText}" FontSize="10" Margin="0,20,0,0" />
              </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>
        <Grid x:Name="PhonesPage" Visibility="Collapsed">
          <Border Style="{StaticResource Card}" Padding="18">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <Grid><TextBlock Text="我的手机号" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" /><Button Content="＋  添加手机号" HorizontalAlignment="Right" Style="{StaticResource PrimaryButton}" Click="NewPhone_Click" /></Grid>
              <TextBlock Grid.Row="1" Text="查看号码关联的账号和官方限制说明；期限未知时保留为空。" Style="{StaticResource MutedText}" Margin="0,11,0,15" />
              <Grid Grid.Row="2">
                <DataGrid x:Name="PhonesGrid" AutomationProperties.Name="手机号列表" MouseDoubleClick="PhonesGrid_DoubleClick">
                  <DataGrid.Columns><DataGridTextColumn Header="号码备注" Binding="{Binding Label}" Width="150" /><DataGridTextColumn Header="手机号" Binding="{Binding Number}" Width="145" /><DataGridTextColumn Header="关联账号" Binding="{Binding Accounts}" Width="100" /><DataGridTextColumn Header="官方提示限制至" Binding="{Binding Restriction}" Width="165" /><DataGridTextColumn Header="官方说明" Binding="{Binding Notice}" Width="*" MinWidth="200" /></DataGrid.Columns>
                </DataGrid>
                <TextBlock x:Name="PhoneEmpty" Text="还没有手机号。点击右上角添加本人号码。" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Grid>
              <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0"><Button Content="复制选中号码" Click="CopyPhone_Click" Margin="0,0,10,0" /><Button Content="查看 / 编辑" Click="EditPhone_Click" /></StackPanel>
            </Grid>
          </Border>
        </Grid>
        <Grid x:Name="RedemptionsPage" Visibility="Collapsed">
          <Border Style="{StaticResource Card}" Padding="18">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <Grid><TextBlock Text="兑换记录" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" /><Button Content="＋  记录兑换结果" HorizontalAlignment="Right" Style="{StaticResource PrimaryButton}" Click="NewRedemption_Click" /></Grid>
              <TextBlock Grid.Row="1" Text="成功、失败和待确认分别保存。只有明确成功并填写的到期时间才会更新账号。" Style="{StaticResource MutedText}" Margin="0,11,0,15" />
              <Grid Grid.Row="2">
                <DataGrid x:Name="RedemptionsGrid" AutomationProperties.Name="兑换记录列表" MouseDoubleClick="RedemptionsGrid_DoubleClick">
                  <DataGrid.Columns><DataGridTextColumn Header="账号" Binding="{Binding Account}" Width="115" /><DataGridTextColumn Header="渠道" Binding="{Binding Provider}" Width="60" /><DataGridTextColumn Header="口令" Binding="{Binding Code}" Width="110" /><DataGridTextColumn Header="结果" Binding="{Binding Outcome}" Width="72" /><DataGridTextColumn Header="兑换时间" Binding="{Binding Time}" Width="150" /><DataGridTextColumn Header="到账时长" Binding="{Binding Duration}" Width="95" /><DataGridTextColumn Header="实际到期" Binding="{Binding Expiry}" Width="150" /><DataGridTextColumn Header="说明" Binding="{Binding Note}" Width="*" MinWidth="150" /></DataGrid.Columns>
                </DataGrid>
                <TextBlock x:Name="RedemptionEmpty" Text="还没有兑换记录。完成官方兑换后，在这里记下结果。" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Grid>
              <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0"><Button Content="复制选中口令" Click="CopyCode_Click" Margin="0,0,10,0" /><Button Content="编辑记录" Click="EditRedemption_Click" /></StackPanel>
            </Grid>
          </Border>
        </Grid>
        <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <StackPanel MaxWidth="900" HorizontalAlignment="Stretch">
            <Border Style="{StaticResource Card}" Padding="22" Margin="0,0,0,15">
              <StackPanel><TextBlock Text="迅雷游戏加速器" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="选择本机客户端的 exe。之后可从账号操作面板打开。" Style="{StaticResource MutedText}" Margin="0,9,0,14" />
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox x:Name="ClientPathBox" IsReadOnly="True" AutomationProperties.Name="迅雷客户端路径" /><Button Grid.Column="1" Content="选择客户端…" Click="ChooseClient_Click" Margin="10,0,0,0" /></Grid>
                <Button Content="打开客户端" Click="OpenClient_Click" HorizontalAlignment="Left" Margin="0,14,0,0" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="22" Margin="0,0,0,15">
              <StackPanel><TextBlock Text="本地数据" FontSize="18" FontWeight="SemiBold" /><TextBlock x:Name="DataPathText" Style="{StaticResource MutedText}" Margin="0,10,0,0" TextWrapping="Wrap" />
                <TextBlock Text="备份方式：关闭软件后，复制整个数据目录。已注销账号的历史记录也保存在这里。" Style="{StaticResource MutedText}" Margin="0,8,0,13" />
                <WrapPanel><Button Content="打开数据目录" Click="OpenDataDirectory_Click" Margin="0,0,10,0" /><Button Content="导出账号 CSV" Click="ExportAccounts_Click" /></WrapPanel>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="22">
              <StackPanel><TextBlock Text="使用说明" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="1. 添加本人手机号和 QQ / 微博账号，建立关联。&#x0a;2. 在官方页面完成注册、授权与时长兑换。&#x0a;3. 记录官方返回结果和实际到期时间，首页会提示即将到期及已到期账号。&#x0a;4. 注销进度单独记录，未知等待期留空；账号注销不代表手机号可立即重新注册。" Style="{StaticResource MutedText}" Margin="0,12,0,0" />
                <TextBlock Text="本工具用于本地记录与入口衔接。QQ 渠道已确认注册入口；微博的完整注册和兑换流程尚待实际验证。" Style="{StaticResource MutedText}" Margin="0,15,0,0" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
      <Grid Grid.Row="3" Margin="0,13,0,0">
        <TextBlock x:Name="StatusText" Text="正在读取本地记录…" Foreground="{StaticResource Muted}" FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,140,0" />
        <Button x:Name="ExportButton" Content="导出当前列表 ↗" Click="ExportCurrent_Click" HorizontalAlignment="Right" MinHeight="26" Padding="8,4" FontSize="10" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Cyan}" />
      </Grid>
    </Grid>
  </Grid>
</Window>
